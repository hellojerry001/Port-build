{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeButler",
  "version": "0.5.0",
  "identifier": "com.jerry.portbutler",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "VibeButler", "width": 980, "height": 680,
                  "minWidth": 860, "minHeight": 560 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
